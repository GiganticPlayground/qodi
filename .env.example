# Qodi environment variables

# Server configuration
QODI_PORT=8080
NODE_ENV=development
# LOG_LEVEL=debug
# LOG_TYPE=pretty

# CORS configuration
# Leave unset to allow all origins.
# Use * to explicitly allow all origins.
# Example: http://localhost:3000,https://app.example.com
# CORS_ORIGINS=*

# Reverse proxy configuration
# TRUST_PROXY=false

# Qodi crypto configuration
QODI_ALGORITHM=RSA-OAEP-SHA256
QODI_CLOCK_SKEW_SECONDS=0
QODI_PRIVATE_KEY_PATH=./config/keys/private-key.pem
QODI_PUBLIC_KEY_PATH=./config/keys/public-key.pem
# QODI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
# QODI_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n..."

# Authentication mode
# One of: static-token, jwt-static, jwt-jwks
QODI_AUTH_MODE=static-token

# Static bearer token mode
QODI_STATIC_TOKEN=replace-with-shared-bearer-token

# JWT static validation mode
# QODI_JWT_SECRET=replace-with-hmac-secret-or-public-key-pem
# QODI_JWT_ALGORITHM=HS256
# QODI_JWT_ISSUER=https://issuer.example.com/
# QODI_JWT_AUDIENCE=qodi-api

# JWT JWKS validation mode
# QODI_JWKS_URI=https://issuer.example.com/.well-known/jwks.json
# QODI_JWKS_CACHE_TTL=300

# Request analytics (reqcast) — opt-in, disabled unless a config file is provided.
# An example config lives at examples/reqcast.config.json (enable/disable, sinks,
# filters, and output format are all defined there). To turn analytics on, point
# REQCAST_CONFIG at a config file — copy the example and adjust, or write your own:
# REQCAST_CONFIG=./examples/reqcast.config.json
